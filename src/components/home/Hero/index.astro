---
import { externalLinks } from "@lib/constants";
import { getEntry } from "astro:content";
const lesson = await getEntry("blog", "belongingness");
---

<progressive-hero>
  <div class="hero-intro" data-intro>
    <h1>Hi, I'm <span>Rami.</span></h1>
    <p class="hero-description">Builder and content creator helping people master the skills AI will never replace.</p>
    <p class="hero-note">Education, personal growth, and the things that make us human.</p>
    <nav class="hero-links" aria-label="Explore my work">
      <a href={externalLinks.youtube} target="_blank" rel="noopener noreferrer">YouTube <span aria-hidden="true">↗</span></a>
      <a href={externalLinks.notes} target="_blank" rel="noopener noreferrer">My journal <span aria-hidden="true">↗</span></a>
      <a href="/contact">Let's connect <span aria-hidden="true">↗</span></a>
      <a href={externalLinks.github} target="_blank" rel="noopener noreferrer">Things I've built <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
  <section class="studio" aria-label="Inside my studio">
    <div class="studio-heading"><span>Inside my studio</span><span class="studio-number" aria-hidden="true">01 / LEARN</span></div>
    <div class="studio-stage">
      <div class="camera-poster" data-poster aria-hidden="true">
        <svg viewBox="0 0 400 280" fill="none">
          <ellipse cx="200" cy="225" rx="160" ry="32" fill="#82664d" />
          <path d="M80 95h60l15-25h70l18 25h75v119H80z" fill="#293b3b" stroke="#78938a" stroke-width="2" />
          <rect x="279" y="90" width="38" height="130" rx="8" fill="#172928" />
          <circle cx="190" cy="154" r="57" fill="#101e21" stroke="#83d9d5" stroke-width="3" />
          <circle cx="190" cy="154" r="40" fill="#173b46" /><circle cx="178" cy="142" r="12" fill="#83d9d5" opacity=".25" />
          <circle cx="107" cy="114" r="5" fill="#f29a77" />
        </svg>
      </div>
      <div class="hero-scene" data-scene aria-hidden="true"></div>
    </div>
    <div class="studio-caption">
      <p class="caption-kicker">A little curiosity goes a long way.</p>
      <a href="/blog/belongingness" class="lesson-trigger" data-explore aria-haspopup="dialog">Learn with me <span aria-hidden="true">↗</span></a>
      <p class="caption-detail">Ideas on belonging, growth, and being yourself.</p>
    </div>
    <div class="scene-control">
      <button type="button" data-start hidden>Explore in 3D</button>
      <p data-status role="status"></p>
    </div>
  </section>
  <dialog aria-labelledby="lesson-title">
    <button class="dialog-close" type="button" data-close aria-label="Close featured lesson">Close <span aria-hidden="true">×</span></button>
    <p class="dialog-kicker">LEARN WITH ME / FEATURED REFLECTION</p>
    <h2 id="lesson-title">{lesson?.data.title}</h2>
    <p class="lesson-description">{lesson?.data.description}.</p>
    <div class="lesson-topics"><span>Authenticity</span><span>Self-worth</span><span>Connection</span></div>
    <p class="lesson-note">A reflection on valuing yourself, showing up as you are, and finding connection through contribution.</p>
    <div class="lesson-actions">
      <a href="https://youtu.be/pIV7OeY_eg4" target="_blank" rel="noopener noreferrer">Watch the reflection <span aria-hidden="true">↗</span></a>
      <a href="/blog/belongingness">Read the journal entry <span aria-hidden="true">→</span></a>
    </div>
    <p class="dialog-footer">Prefer to explore? <a href={externalLinks.youtube} target="_blank" rel="noopener noreferrer">All my videos ↗</a></p>
  </dialog>
</progressive-hero>

<script>
  class ProgressiveHero extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>("[data-start]")!;
      const scene = this.querySelector<HTMLElement>("[data-scene]")!;
      const status = this.querySelector<HTMLElement>("[data-status]")!;
      const explore = this.querySelector<HTMLAnchorElement>("[data-explore]")!;
      const dialog = this.querySelector<HTMLDialogElement>("dialog")!;
      const controller = new AbortController();
      const { signal } = controller;
      const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
      const manual = connection?.saveData || ["slow-2g", "2g"].includes(connection?.effectiveType ?? "") || matchMedia("(prefers-reduced-motion: reduce)").matches;
      let active = true;
      let started = false;
      let dispose: (() => void) | undefined;
      let idle: number | undefined;
      let timer: ReturnType<typeof setTimeout> | undefined;
      let frame = 0;
      let previousOverflow = "";
      const openLesson = () => {
        if (!active || dialog.open) return;
        previousOverflow = document.body.style.overflow;
        dialog.showModal();
        document.body.style.overflow = "hidden";
      };
      explore.addEventListener("click", (event) => { event.preventDefault(); openLesson(); }, { signal });
      this.querySelector("[data-close]")!.addEventListener("click", () => dialog.close(), { signal });
      dialog.addEventListener("click", (event) => {
        const rect = dialog.getBoundingClientRect();
        if (event.target === dialog && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) dialog.close();
      }, { signal });
      dialog.addEventListener("close", () => {
        document.body.style.overflow = previousOverflow;
        if (active) explore.focus({ preventScroll: true });
      }, { signal });
      const unavailable = () => {
        if (!active) return;
        this.removeAttribute("data-ready");
        status.textContent = "You can explore the lesson without 3D.";
      };
      const start = async () => {
        if (started || !active) return;
        started = true;
        button.hidden = true;
        status.textContent = "Bringing the studio to life…";
        try {
          const { mountScene } = await import("./mountScene");
          if (!active) return;
          dispose = mountScene(scene, {
            onReady: () => {
              if (!active) return;
              this.setAttribute("data-ready", "");
              status.textContent = "Tap the camera or choose Learn with me.";
            },
            onError: unavailable,
            onExplore: openLesson,
          });
        } catch { unavailable(); }
      };
      button.hidden = false;
      button.addEventListener("click", start, { signal });
      if (!manual) {
        // paint the introduction before downloading the optional studio.
        frame = requestAnimationFrame(() => {
          frame = requestAnimationFrame(() => {
            if ("requestIdleCallback" in window) idle = window.requestIdleCallback(() => void start(), { timeout: 1500 });
            else timer = setTimeout(start, 200);
          });
        });
      }
      this.cleanup = () => {
        active = false;
        if (dialog.open) { dialog.close(); document.body.style.overflow = previousOverflow; }
        controller.abort();
        cancelAnimationFrame(frame);
        if (idle !== undefined) window.cancelIdleCallback(idle);
        clearTimeout(timer);
        dispose?.();
      };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get("progressive-hero")) customElements.define("progressive-hero", ProgressiveHero);
</script>

<style>
  progressive-hero { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 6rem); align-items: center; min-height: calc(100svh - 10rem); padding: 3rem 0 7rem; width: 100%; }
  h1 { font-size: clamp(3.6rem, 6.6vw, 6rem); font-weight: 750; line-height: 1.03; letter-spacing: -.06em; color: #eefcff; }
  h1 span { color: #67e8f9; display: block; }
  .hero-description { margin-top: 1.8rem; max-width: 30rem; font-size: clamp(1.15rem, 1.8vw, 1.45rem); line-height: 1.55; color: #d0dcd9; }
  .hero-note { margin-top: 1rem; max-width: 26rem; font-size: .95rem; line-height: 1.65; color: #99aca8; }
  .hero-links { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; margin-top: 2rem; max-width: 29rem; }
  .hero-links a { font-size: .9rem; padding-bottom: .35rem; border-bottom: 1px solid #4c6563; }
  .hero-links a span { margin-left: .4rem; color: #72dce6; }
  a:hover { color: #8be9ed; }
  a:focus-visible, button:focus-visible { outline: 2px solid #67e8f9; outline-offset: 5px; }
  .studio { position: relative; background: radial-gradient(ellipse at 60% 35%, #64513d66, #19272855 60%, #13202244); border: 1px solid #d4b58a33; border-radius: 1.5rem; overflow: hidden; }
  .studio-heading { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.5rem 1.5rem 0; color: #d9c7ab; font-size: .85rem; }
  .studio-number { font-size: .65rem; letter-spacing: .12em; color: #a49f8e; }
  .studio-stage { position: relative; height: clamp(240px, 28vw, 360px); }
  .camera-poster, .hero-scene { position: absolute; inset: 0; }
  .camera-poster svg { width: 100%; height: 100%; }
  .hero-scene { opacity: 0; pointer-events: none; }
  progressive-hero[data-ready] .hero-scene { opacity: 1; pointer-events: auto; cursor: pointer; }
  progressive-hero[data-ready] .camera-poster { visibility: hidden; }
  .studio-caption { padding: 0 1.75rem; }
  .caption-kicker { font-family: Georgia, serif; font-style: italic; font-size: 1rem; color: #c2b598; }
  .lesson-trigger { display: flex; justify-content: space-between; align-items: center; margin-top: .7rem; font-size: clamp(1.65rem, 3vw, 2.2rem); letter-spacing: -.04em; font-weight: 600; }
  .lesson-trigger span { color: #67e8f9; }
  .caption-detail { margin-top: .65rem; font-size: .85rem; line-height: 1.6; color: #acbcb7; }
  .scene-control { padding: 1rem 1.75rem 1.4rem; min-height: 3.9rem; }
  .scene-control button { font-size: .8rem; color: #a6e7e9; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .scene-control p { font-size: .75rem; color: #9aaba6; }
  dialog { color: #e7eeea; background: #192522; border: 1px solid #bda78666; border-radius: 1.4rem; width: min(640px, calc(100vw - 2rem)); max-height: calc(100svh - 2rem); padding: clamp(1.5rem, 5vw, 3rem); margin: auto; overflow-y: auto; box-shadow: 0 30px 120px #0009; }
  dialog::backdrop { background: #07110fde; backdrop-filter: blur(8px); }
  .dialog-close { display: block; margin-left: auto; font-size: .85rem; color: #bdd0c6; padding: .4rem 0 .6rem 1rem; cursor: pointer; }
  .dialog-close span { font-size: 1.4rem; margin-left: .6rem; }
  .dialog-kicker { margin-top: 1rem; color: #d3ba94; font-size: .65rem; letter-spacing: .15em; }
  h2 { font-family: Georgia, serif; font-size: clamp(2rem, 5vw, 3rem); line-height: 1.15; letter-spacing: -.035em; margin-top: 1.3rem; }
  .lesson-description, .lesson-note { color: #b8c8c1; line-height: 1.7; margin-top: 1.4rem; }
  .lesson-topics { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.4rem; }
  .lesson-topics span { font-size: .75rem; border: 1px solid #8ba79555; border-radius: 2rem; padding: .4rem .7rem; color: #a9d1c7; }
  .lesson-actions { display: grid; gap: .7rem; margin-top: 1.8rem; }
  .lesson-actions a { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem; border: 1px solid #789e9466; border-radius: .6rem; font-size: .95rem; }
  .lesson-actions a:first-child { background: #a4e3dc; color: #152d2a; border: 0; }
  .dialog-footer { color: #9db2a8; font-size: .8rem; margin-top: 1.8rem; }
  .dialog-footer a { color: #d6e3dc; text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 760px) {
    progressive-hero { grid-template-columns: 1fr; gap: 2.5rem; padding-top: 2rem; padding-bottom: 7rem; }
    h1 { font-size: clamp(3.6rem, 12vw, 5.5rem); } h1 span { display: inline; }
    .hero-description { font-size: 1.15rem; margin-top: 1.3rem; }
    .hero-links { gap: 1rem 1.3rem; }
    .studio-stage { height: 280px; }
    .studio-heading { padding: 1.2rem 1.2rem 0; }
    .studio-caption { padding: 0 1.2rem; }
    .scene-control { padding: 1rem 1.2rem 1.2rem; }
  }
</style>
